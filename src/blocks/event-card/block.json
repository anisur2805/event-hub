{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "event-hub/event-card",
  "version": "1.0.0",
  "title": "Event Card",
  "category": "widgets",
  "description": "Single event card with datetime, venue, and RSVP button.",
  "textdomain": "event-hub",
  "attributes": {
    "eventId": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "interactivity": true,
    "html": false
  },
  "editorScript": "file:./index.js",
  "viewScriptModule": "file:./view.js",
  "style": "event-hub-blocks"
}
