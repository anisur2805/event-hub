{"name": "event-hub/event-hub", "description": "Events + RSVP plugin with capacity-aware registration.", "type": "wordpress-plugin", "license": "GPL-2.0-or-later", "require": {"php": ">=8.1"}, "require-dev": {"phpstan/phpstan": "2.3.2", "szepeviktor/phpstan-wordpress": "2.0.4", "wp-coding-standards/wpcs": "3.4.1", "dealerdirect/phpcodesniffer-composer-installer": "1.2.1", "yoast/phpunit-polyfills": "4.0.0"}, "autoload": {"psr-4": {"EventHub\\": "includes/"}}, "config": {"allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}}, "scripts": {"phpcs": "phpcs --standard=phpcs.xml --report=full", "phpcbf": "phpcbf --standard=phpcs.xml", "phpstan": "phpstan analyse --configuration=phpstan.neon --no-progress", "test": "phpunit --configuration=phpunit.xml.dist"}}