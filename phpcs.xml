<?xml version="1.0"?>
<ruleset name="EventHub">
	<description>WordPress Coding Standards for the Event Hub plugin.</description>

	<!-- Scan the plugin PHP. -->
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<!-- Dev-only PHPStan bootstrap: defines ABSPATH for analyse-time stubs. -->
	<exclude-pattern>/phpstan-bootstrap\.php$</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- WPCS -->
	<rule ref="WordPress">
		<!-- PSR-4 file names win over WPCS class-file naming (docs/DECISIONS.md #15). -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Render.php templates mix HTML; keep indent sniffs but allow short echo. -->
		<exclude name="Universal.Operators.StrictComparisons"/>
	</rule>

	<!-- PHP 8.1 floor. -->
	<config name="testVersion" value="8.1-"/>

	<!-- Text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element name="0" value="event-hub"/>
			</property>
		</properties>
	</rule>

	<!-- Prefix check for functions/classes/globals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element name="0" value="EventHub"/>
				<element name="1" value="event_hub"/>
			</property>
		</properties>
		<!-- render.php templates receive $attributes/$content etc. from core by contract;
		     WP core's own render.php files use the same unprefixed locals. -->
		<exclude-pattern>includes/blocks/*/render\.php$</exclude-pattern>
		<!-- Analyse-time WP_CLI signature stub (never loaded at runtime). -->
		<exclude-pattern>includes/class-wp-cli-stub\.php$</exclude-pattern>
	</rule>
</ruleset>
