parameters:
	level: 6
	paths:
		- includes
		- event-hub.php
	excludePaths:
		- vendor
		# build/ exists only after `npm run build`; optional so a PHP-only
		# checkout (CI php-static job) analyses without it.
		- build (?)
		- tests
	bootstrapFiles:
		- phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors: []

includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
